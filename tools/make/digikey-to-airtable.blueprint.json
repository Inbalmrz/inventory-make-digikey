          },
          {
            "name": "leadDays",
            "value": "{{if(parseNumber(5.ManufacturerLeadWeeks; \".\") > 0; min(parseNumber(5.ManufacturerLeadWeeks; \".\") * 7; 120); 14)}}"
          },
          {
            "name": "skuKey",
            "value": ";{{ifempty(first(map(5.ProductVariations; \"DigiKeyProductNumber\")); 5.DigiKeyProductNumber)}}="
          },
          {
            "name": "supKey",
